{
  "expo": {
    "name": "expo-weather-kit-example",
    "slug": "expo-weather-kit-example",
    "scheme": "expo-weather-kit-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.0",
      "bundleIdentifier": "expo.modules.weatherkit.example",
      "entitlements": {
        "com.apple.developer.weatherkit": true
      },
      "appleTeamId": "56275CMVJ2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.weatherkit.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a9f4e468-dfac-4990-ab2c-a476c52077bd"
      }
    },
    "owner": "kubacienciala"
  }
}
